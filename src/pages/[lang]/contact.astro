---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ContactForm from '@/components/sections/ContactForm.astro';
import { locales, useTranslations, type Locale } from '@/i18n/utils';
import { getPage, getSiteSettings } from '@/content/helpers';

export function getStaticPaths() {
  return locales.map(lang => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);
const page = await getPage('contact', lang);
const site = await getSiteSettings();
---

<BaseLayout lang={lang} title={page.seoTitle} description={page.seoDescription}>
  <section class="section">
    <div class="container contact">
      <div class="contact__intro">
        <h1>{page.title}</h1>
        <p class="contact__lead">{page.lead}</p>

        <p class="label">{t('footer.address')}</p>
        <address class="contact__address">
          {site.companyName}
          <br />
          {site.address.street}
          <br />
          {site.address.box}
          <br />
          {site.address.postalCode} {site.address.city}, {site.address.country}
        </address>
        <p>
          <a class="accent" href={`mailto:${site.email}`}>
            {site.email}
          </a>
        </p>
      </div>

      <ContactForm lang={lang} />
    </div>
  </section>
</BaseLayout>

<style>
  .contact {
    display: grid;
    gap: var(--space-12);
  }

  @media (min-width: 1024px) {
    .contact {
      grid-template-columns: 1fr 1.4fr;
      gap: var(--space-24);
    }
  }

  .contact__lead {
    margin-block: var(--space-4) var(--space-12);
    font-size: var(--fs-body-lg);
    color: var(--color-text-secondary);
  }

  .contact .label {
    margin-bottom: var(--space-3);
  }

  .contact__address {
    font-style: normal;
    margin-bottom: var(--space-4);
    color: var(--color-text-secondary);
  }
</style>
