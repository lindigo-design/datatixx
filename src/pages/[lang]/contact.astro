---
/** Сторінка Contact (Figma «Contact • Desktop (new)»). */
import BaseLayout from '@/layouts/BaseLayout.astro';
import ContactHero from '@/components/sections/contact/ContactHero.astro';
import ContactSplit from '@/components/sections/contact/ContactSplit.astro';
import { locales, type Locale } from '@/i18n/utils';
import { getContact } from '@/content/helpers';

export function getStaticPaths() {
  return locales.map(lang => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const page = await getContact(lang);
---

<BaseLayout lang={lang} title={page.seoTitle} description={page.seoDescription}>
  <ContactHero data={page.hero} />
  <ContactSplit lang={lang} map={page.map} territorial={page.territorial} />
</BaseLayout>
