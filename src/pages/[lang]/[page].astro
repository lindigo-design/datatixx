---
/**
 * Юридичні сторінки: Legal notice (legal), Privacy Policy (privacy), Cookie Policy (cookies).
 * Тексти — Markdown у src/content/legal/<мова>/<сторінка>.md (дата оновлення — у полі `updated`).
 */
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { useTranslations, type Locale } from '@/i18n/utils';

export async function getStaticPaths() {
  const docs = await getCollection('legal');
  return docs.map(doc => {
    const [lang, page] = doc.id.split('/');
    return { params: { lang, page }, props: { doc } };
  });
}

const { doc } = Astro.props;
const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);
const { Content } = await render(doc);
const updated = doc.data.updated.toLocaleDateString(
  lang === 'fr' ? 'fr-FR' : 'en-GB',
  { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }
);
---

<BaseLayout
  lang={lang}
  title={`${doc.data.title} — DataTixx`}
  description={doc.data.description}
>
  <article class="section legal">
    <div class="container legal__inner">
      <header class="legal__head">
        <h1 class="section-title">{doc.data.title}</h1>
        <p class="legal__updated">
          {t('legal.updated')}:{' '}
          <time datetime={doc.data.updated.toISOString().slice(0, 10)}>
            {updated}
          </time>
        </p>
      </header>
      <div class="legal__body">
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .legal__inner {
    display: grid;
    gap: var(--space-10);
    max-width: 820px;
  }

  .legal__head {
    display: grid;
    gap: var(--space-3);
  }

  .legal__updated {
    color: var(--color-text-muted);
  }

  /* Текст з Markdown: заголовки, абзаци, списки, таблиці, посилання */
  .legal__body {
    display: grid;
    gap: var(--space-4);
    color: var(--color-text-secondary);
  }

  .legal__body :global(h2) {
    margin-top: var(--space-8);
    font-size: var(--fs-h3);
    font-weight: var(--fw-semibold);
    line-height: 1.3;
    color: var(--color-text);
  }

  .legal__body :global(h3) {
    margin-top: var(--space-4);
    font-size: var(--fs-body-lg);
    font-weight: var(--fw-semibold);
    color: var(--color-text);
  }

  .legal__body :global(strong) {
    color: var(--color-text);
    font-weight: var(--fw-semibold);
  }

  .legal__body :global(ul) {
    display: grid;
    gap: var(--space-2);
    padding-left: 1.25em;
    list-style: disc;
  }

  .legal__body :global(li::marker) {
    color: var(--color-green);
  }

  .legal__body :global(a) {
    color: var(--color-text);
    text-decoration: underline;
    text-underline-offset: 3px;
    overflow-wrap: anywhere;
  }

  .legal__body :global(a:hover) {
    color: var(--color-green);
  }

  .legal__body :global(code) {
    font-family: var(--font-mono, monospace);
    font-size: 0.9em;
    color: var(--color-text);
  }

  /* Таблиці: на вузьких екранах гортаються вбік, сторінка не ширшає */
  .legal__body :global(table) {
    display: block;
    max-width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    font-size: var(--fs-small);
  }

  .legal__body :global(th),
  .legal__body :global(td) {
    padding: var(--space-2) var(--space-3);
    border-bottom: 1px solid var(--color-hairline);
    text-align: left;
    vertical-align: top;
  }

  .legal__body :global(th) {
    color: var(--color-text);
    font-weight: var(--fw-semibold);
    white-space: nowrap;
  }
</style>
