---
/**
 * Сторінка блогу — Figma «Blog • Desktop (light)».
 * Hero (остання стаття) → Topics → Latest articles → Newsletter.
 * Тексти — src/content/pages/<мова>/blog.json (Keystatic: «Blog page»).
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import BlogHero from '@/components/blog/BlogHero.astro';
import BlogTopics from '@/components/blog/BlogTopics.astro';
import BlogArticles from '@/components/blog/BlogArticles.astro';
import NewsletterBand from '@/components/blog/NewsletterBand.astro';
import { locales, type Locale } from '@/i18n/utils';
import { getBlogPage, getPosts } from '@/content/blog';

export function getStaticPaths() {
  return locales.map(lang => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const page = await getBlogPage(lang);
const posts = await getPosts(lang);
const nameOf = (key: string) =>
  page.categories.find(c => c.key === key)?.name ?? '';
const counts: Record<string, number> = {};
for (const p of posts)
  counts[p.data.category] = (counts[p.data.category] ?? 0) + 1;
const latest = posts[0];
---

<BaseLayout
  lang={lang}
  title={page.seoTitle}
  description={page.seoDescription}
  mainClass="theme-light"
>
  <BlogHero
    page={page}
    post={latest}
    categoryName={latest && nameOf(latest.data.category)}
  />
  {posts.length > 0 && (
    <>
      <BlogTopics
        lang={lang}
        topics={page.topics}
        categories={page.categories}
        counts={counts}
      />
      <BlogArticles
        posts={posts}
        latest={page.latest}
        filterLabel={page.topics.label}
        minRead={page.article.minRead}
        categories={page.categories}
      />
    </>
  )}
  <NewsletterBand lang={lang} />
</BaseLayout>
