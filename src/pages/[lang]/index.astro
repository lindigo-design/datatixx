---
/** Головна сторінка — порядок секцій як у Figma «Home • Desktop». */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/sections/Hero.astro';
import Marquee from '@/components/sections/Marquee.astro';
import Features from '@/components/sections/Features.astro';
import WhyTixx from '@/components/sections/WhyTixx.astro';
import PartnersStrip from '@/components/sections/PartnersStrip.astro';
import About from '@/components/sections/About.astro';
import ModelStats from '@/components/sections/ModelStats.astro';
import BenefitsByRole from '@/components/sections/BenefitsByRole.astro';
import Team from '@/components/sections/Team.astro';
import CtaBand from '@/components/sections/CtaBand.astro';
import {
  locales,
  localizePath,
  useTranslations,
  type Locale,
} from '@/i18n/utils';
import { getHome } from '@/content/helpers';

export function getStaticPaths() {
  return locales.map(lang => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);
const page = await getHome(lang);
const to = (path: string) => localizePath(path, lang);
---

<BaseLayout lang={lang} title={page.seoTitle} description={page.seoDescription}>
  <Hero {...page.hero} primaryHref={to('contact')} secondaryHref="#features" />
  <Marquee items={page.marquee} label={t('marquee.label')} />
  <Features data={page.features} />
  <WhyTixx
    data={page.why}
    primaryHref={to('benefits')}
    secondaryHref={to('about')}
  />
  <About data={page.about} ctaHref={to('about')} />
  <PartnersStrip label={t('partners.label')} />
  <ModelStats
    data={page.model}
    primaryHref={to('platform')}
    secondaryHref={to('platform')}
  />
  <BenefitsByRole data={page.benefits} />
  <Team data={page.team} />
  <CtaBand data={page.cta} href={to('contact')} />
</BaseLayout>
