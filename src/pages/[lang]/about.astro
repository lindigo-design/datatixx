---
/** Сторінка About — порядок секцій як у Figma «About • Desktop». */
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/sections/PageHero.astro';
import StoryActs from '@/components/sections/about/StoryActs.astro';
import Discovery from '@/components/sections/about/Discovery.astro';
import Manifesto from '@/components/sections/about/Manifesto.astro';
import DataPillars from '@/components/sections/about/DataPillars.astro';
import ToolsSplit from '@/components/sections/about/ToolsSplit.astro';
import CtaBand from '@/components/sections/CtaBand.astro';
import heroImage from '@/assets/img/about/hero-europe.jpg';
import { locales, localizePath, type Locale } from '@/i18n/utils';
import { getAbout } from '@/content/helpers';

export function getStaticPaths() {
  return locales.map(lang => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const page = await getAbout(lang);
const to = (path: string) => localizePath(path, lang);
---

<BaseLayout lang={lang} title={page.seoTitle} description={page.seoDescription}>
  <PageHero
    {...page.hero}
    primaryHref={to('platform')}
    secondaryHref={to('benefits')}
    image={heroImage}
  />
  <StoryActs data={page.story} />
  <Discovery data={page.discovery} />
  <Manifesto data={page.manifesto} />
  <DataPillars data={page.data} />
  <ToolsSplit
    data={page.tools}
    primaryHref={to('platform')}
    secondaryHref={to('benefits')}
  />
  <CtaBand data={page.cta} href={to('contact')} />
</BaseLayout>
