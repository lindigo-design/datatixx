---
/**
 * Hero сторінки блогу: «BLOG / datixxia™ insights» + велика картка останньої статті.
 * Якщо статей ще немає — текст «Articles are coming soon.».
 */
import { Image } from 'astro:assets';
import { postMeta, postUrl, type Post } from '@/content/blog';

interface Props {
  page: {
    hero: {
      label: string;
      title: string;
      lead: string;
      latest: string;
      readArticle: string;
    };
    latest: { comingSoon: string };
    article: { minRead: string };
  };
  post?: Post;
  categoryName?: string;
}

const { page, post, categoryName } = Astro.props;
// «Read article →»: стрілку рухаємо окремо при наведенні
const readLabel = page.hero.readArticle.replace(/\s*→\s*$/, '');
const hasArrow = readLabel !== page.hero.readArticle;
---

<section class="blog-hero">
  <div class="container">
    <div class="blog-hero__head">
      <div class="blog-hero__titles">
        <p class="section-label">{page.hero.label}</p>
        <h1 class="blog-hero__title">{page.hero.title}</h1>
      </div>
      <p class="blog-hero__lead">{page.hero.lead}</p>
    </div>

    {post ? (
      <a class="featured" href={postUrl(post)}>
        <Image
          class="featured__img"
          src={post.data.cover}
          alt=""
          widths={[640, 1240, 1920]}
          sizes="(min-width: 1440px) 1240px, 92vw"
          loading="eager"
          fetchpriority="high"
        />
        <span class="featured__chip">
          <span class="featured__dot" aria-hidden="true" />
          {page.hero.latest} · {categoryName}
        </span>
        <h2 class="featured__title">{post.data.title}</h2>
        <span class="featured__row">
          <span class="featured__meta">
            {postMeta(post, page.article.minRead)}
          </span>
          <span class="featured__btn" aria-hidden="true">
            {readLabel}
            {hasArrow && <span class="featured__arrow">→</span>}
          </span>
        </span>
      </a>
    ) : (
      <p class="blog-hero__empty">{page.latest.comingSoon}</p>
    )}
  </div>
</section>

<style>
  .blog-hero {
    padding-top: clamp(2.5rem, 1.9rem + 2.6vw, 4.5rem); /* 40 → 72 */
    padding-bottom: clamp(4rem, 3.4rem + 2.6vw, 6rem); /* 64 → 96 */
  }

  .blog-hero__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-6) var(--space-10);
  }

  .blog-hero__titles {
    display: grid;
    gap: var(--space-3);
  }

  .blog-hero__title {
    font-size: var(--fs-h2); /* 40 → 74 */
    font-weight: var(--fw-bold);
    line-height: 0.9;
    color: var(--light-ink);
  }

  .blog-hero__lead {
    max-width: 420px;
    font-size: var(--fs-body-lg);
    line-height: var(--lh-body);
    color: var(--light-text-secondary);
  }

  .blog-hero__empty {
    margin-top: var(--space-10);
    font-size: var(--fs-body-lg);
    color: var(--light-text-secondary);
  }

  /* ---------- Картка останньої статті ---------- */
  .featured {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: flex-start;
    gap: var(--space-4);
    min-height: clamp(26rem, 20rem + 18vw, 35rem); /* 416 → 560 */
    margin-top: var(--space-10);
    padding: clamp(1.5rem, 1.1rem + 1.6vw, 2.5rem); /* 24 → 40 */
    overflow: hidden;
    border-radius: 28px;
    color: var(--color-text);
    background: var(--color-bg);
  }

  .featured::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      180deg,
      rgb(1 9 18 / 0) 35%,
      rgb(1 9 18 / 0.92) 100%
    );
  }

  .featured__img {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 600ms var(--ease-out);
  }

  .featured:hover .featured__img,
  .featured:focus-visible .featured__img {
    transform: scale(1.03);
  }

  .featured__chip {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-4) var(--space-2) 14px;
    border-radius: var(--radius-pill);
    background: rgb(255 255 255 / 0.92);
    color: var(--light-ink);
    font-size: var(--fs-label-14);
    font-weight: var(--fw-medium);
    line-height: 1.3;
  }

  .featured__dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--color-green);
  }

  .featured__title {
    max-width: 820px;
    font-size: clamp(1.75rem, 1.25rem + 2.2vw, 3rem); /* 28 → 48 */
    font-weight: var(--fw-semibold);
    line-height: 1.1;
    text-wrap: balance;
  }

  .featured__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4) var(--space-6);
  }

  .featured__meta {
    font-family: var(--font-mono);
    font-size: var(--fs-meta-s);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.8);
  }

  .featured__btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 10px var(--space-5);
    border: 1px solid rgb(255 255 255 / 0.6);
    border-radius: var(--radius-pill);
    font-size: var(--fs-body);
    font-weight: var(--fw-semibold);
    line-height: 1.2;
    transition: border-color var(--dur-fast) ease;
  }

  .featured__arrow {
    transition: transform var(--dur-base) var(--ease-out);
  }

  .featured:hover .featured__btn {
    border-color: var(--color-text);
  }

  .featured:hover .featured__arrow,
  .featured:focus-visible .featured__arrow {
    transform: translateX(4px);
  }

  .featured:focus-visible {
    outline-offset: 4px;
  }
</style>
