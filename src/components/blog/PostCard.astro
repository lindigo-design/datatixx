---
/**
 * Картка статті: сітка результатів пошуку на сторінці блогу і «Keep reading» у статті.
 * Уся картка — одне посилання.
 */
import { Image } from 'astro:assets';
import { postMeta, postUrl, type Post } from '@/content/blog';

interface Props {
  post: Post;
  categoryName: string;
  minRead: string;
  /** Рівень заголовка картки (h2 у сітці, h3 у «Keep reading») */
  as?: 'h2' | 'h3';
}

const { post, categoryName, minRead, as: Heading = 'h3' } = Astro.props;
---

<a class="post-card" href={postUrl(post)}>
  <span class="post-card__media">
    <Image
      class="post-card__img"
      src={post.data.cover}
      alt=""
      widths={[400, 800]}
      sizes="(min-width: 1024px) 400px, (min-width: 640px) 50vw, 100vw"
      loading="lazy"
    />
  </span>
  <span class="post-card__text">
    <span class="post-category">{categoryName}</span>
    <Heading class="post-card__title">{post.data.title}</Heading>
    <span class="post-meta">{postMeta(post, minRead)}</span>
  </span>
</a>

<style>
  .post-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border: 1px solid rgb(13 17 23 / 0.08);
    border-radius: var(--radius-md);
    background: var(--light-surface);
    color: var(--light-ink);
  }

  .post-card__media {
    display: block;
    height: 240px;
    overflow: hidden;
  }

  .post-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 600ms var(--ease-out);
  }

  .post-card__text {
    display: grid;
    align-content: start;
    gap: 10px;
    padding: var(--space-6);
  }

  .post-card__title {
    font-size: var(--fs-card-title);
    font-weight: var(--fw-semibold);
    line-height: 1.25;
    transition: color var(--dur-fast) ease;
  }

  .post-card:hover .post-card__img,
  .post-card:focus-visible .post-card__img {
    transform: scale(1.03);
  }

  .post-card:hover .post-card__title,
  .post-card:focus-visible .post-card__title {
    color: var(--color-blue);
  }
</style>
