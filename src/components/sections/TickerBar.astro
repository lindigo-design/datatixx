---
/**
 * Ticker bar (Figma: «Ticker bar», 40px) — індекси Tixx™ під навігацією.
 * Дані: src/content/site/settings.json → ticker. Зараз значення ілюстративні.
 */
import { useTranslations, type Locale } from '@/i18n/utils';
import { getSiteSettings } from '@/content/helpers';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const { ticker } = await getSiteSettings();
const fmtValue = (n: number) => n.toFixed(2);
const fmtChange = (n: number) =>
  `${n >= 0 ? '+' : '−'}${Math.abs(n).toFixed(1)}%`;
---

<section class="ticker" aria-label={t('ticker.label')}>
  <ul role="list" class="visually-hidden">
    {ticker.map(i => (
      <li>
        {i.name}: {fmtValue(i.value)}, {fmtChange(i.change)}
      </li>
    ))}
  </ul>
  <div class="ticker__track" aria-hidden="true">
    {[0, 1].map(() => (
      <ul role="list" class="ticker__group">
        {ticker.map(i => (
          <li class="ticker__item num">
            <span class="ticker__name">{i.name}</span>
            <span class="ticker__value">{fmtValue(i.value)}</span>
            <span
              class:list={[
                'ticker__change',
                i.change >= 0 ? 'is-up' : 'is-down',
              ]}
            >
              {i.change >= 0 ? '▲' : '▼'} {fmtChange(i.change)}
            </span>
          </li>
        ))}
      </ul>
    ))}
  </div>
</section>

<style>
  .ticker {
    height: var(--ticker-h);
    overflow: hidden;
    background: var(--color-ticker-bg);
    display: flex;
    align-items: center;
  }

  .ticker__track {
    display: flex;
    width: max-content;
    animation: ticker-move 60s linear infinite;
  }

  .ticker:hover .ticker__track {
    animation-play-state: paused;
  }

  .ticker__group {
    display: flex;
    gap: var(--space-10);
    padding-right: var(--space-10);
  }

  .ticker__item {
    display: flex;
    gap: var(--space-2);
    font-size: var(--fs-small);
    font-weight: var(--fw-medium);
    line-height: 20px;
    white-space: nowrap;
  }

  .ticker__name {
    color: var(--color-text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .ticker__value {
    color: var(--color-text);
  }

  .is-up {
    color: var(--color-up);
  }

  .is-down {
    color: var(--color-down);
  }

  @keyframes ticker-move {
    to {
      transform: translateX(-50%);
    }
  }
</style>
