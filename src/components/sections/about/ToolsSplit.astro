---
/** Tools — Dashboard: текст і переваги ліворуч, скриншот Grafixx™ праворуч. */
import { Image } from 'astro:assets';
import Button from '@/components/ui/Button.astro';
import dashboard from '@/assets/img/about/tools-dashboard.png';

interface Props {
  data: {
    label: string;
    titleLine1: string;
    titleLine2: string;
    text: string;
    points: string[];
    primaryCta: string;
    secondaryCta: string;
    imageAlt: string;
  };
  primaryHref: string;
  secondaryHref: string;
}
const { data, primaryHref, secondaryHref } = Astro.props;
---

<section class="section tools" aria-labelledby="tools-title">
  <div class="container tools__inner">
    <div class="tools__content">
      <p class="section-label">{data.label}</p>
      <h2 id="tools-title" class="section-title">
        {data.titleLine1}
        <br />
        <span class="grad-text">{data.titleLine2}</span>
      </h2>
      <p class="tools__text">{data.text}</p>
      <ul role="list" class="tools__points">
        {data.points.map(p => (
          <li>{p}</li>
        ))}
      </ul>
      <div class="actions tools__actions">
        <Button href={primaryHref}>{data.primaryCta}</Button>
        <Button href={secondaryHref} variant="outline">
          {data.secondaryCta}
        </Button>
      </div>
    </div>
    <div class="tools__media">
      <Image
        src={dashboard}
        alt={data.imageAlt}
        widths={[560, 840, 1120]}
        sizes="(min-width: 1024px) 560px, 100vw"
        loading="lazy"
      />
    </div>
  </div>
</section>

<style>
  .tools__inner {
    display: grid;
    gap: var(--space-12);
    align-items: center;
  }

  @media (min-width: 1024px) {
    .tools__inner {
      grid-template-columns: 600fr 560fr;
      gap: var(--space-20);
    }
  }

  .tools__content {
    display: grid;
    gap: var(--space-6);
    justify-items: start;
  }

  .tools__content .section-label {
    margin-bottom: calc(var(--space-2) * -1);
  }

  .tools__text {
    font-size: var(--fs-body-lg);
    color: var(--color-text-secondary);
  }

  .tools__points {
    display: grid;
    gap: var(--space-3);
    padding-top: var(--space-2);
  }

  .tools__points li {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    font-size: var(--fs-body-lg);
  }

  .tools__points li::before {
    content: '';
    flex-shrink: 0;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--gradient-brand);
    transform: translateY(-2px);
  }

  .tools__actions {
    padding-top: var(--space-2);
  }

  .tools__media {
    border-radius: var(--radius-md);
    border: 1px solid var(--color-hairline);
    overflow: hidden;
    aspect-ratio: 560 / 460;
    background: var(--color-paper);
  }

  .tools__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: left top;
  }
</style>
