---
/** «Team — Profiles»: дві великі картки з фото, імʼям, посадою і біографією. */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { paragraphs } from '@/utils/text';

interface Props {
  members: {
    name: string;
    role: string;
    photo: ImageMetadata;
    photoAlt: string;
    bio: string;
  }[];
}
const { members } = Astro.props;
---

<section class="profiles" aria-label="Team">
  <div class="container">
    <ul role="list" class="profiles__list">
      {members.map(m => {
        const [first, ...rest] = paragraphs(m.bio);
        return (
          <li class="profile">
            <Image
              src={m.photo}
              alt={m.photoAlt}
              class="profile__photo"
              widths={[400, 700, 1100]}
              sizes="(min-width: 1024px) 550px, 100vw"
              loading="lazy"
            />
            <div class="profile__head">
              <h2 class="profile__name">{m.name}</h2>
              <p class="profile__role meta-s">{m.role}</p>
            </div>
            <p class="profile__lead">{first}</p>
            {rest.map(p => (
              <p class="profile__text">{p}</p>
            ))}
          </li>
        );
      })}
    </ul>
  </div>
</section>

<style>
  .profiles {
    padding-bottom: var(--section-pad);
  }

  .profiles__list {
    display: grid;
    gap: var(--space-6);
  }

  @media (min-width: 900px) {
    .profiles__list {
      grid-template-columns: 1fr 1fr;
    }
  }

  .profile {
    display: grid;
    align-content: start;
    gap: var(--space-4);
    padding: 28px;
    background: var(--color-surface);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-lg);
  }

  .profile__photo {
    width: 100%;
    aspect-ratio: 550 / 420;
    object-fit: cover;
    object-position: center 25%;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-hairline);
    margin-bottom: var(--space-2);
  }

  .profile__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2) var(--space-6);
  }

  .profile__name {
    font-size: clamp(2rem, 1.7rem + 1.3vw, 2.75rem);
    font-weight: var(--fw-semibold);
    line-height: 1.1;
  }

  .profile__role {
    color: var(--color-green);
  }

  .profile__lead {
    color: var(--color-text);
  }

  .profile__text {
    color: var(--color-text-muted);
  }
</style>
