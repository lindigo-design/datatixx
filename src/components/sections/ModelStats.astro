---
/** Stats / 17 / — «Datixxia™ Forecasting Model» + 4 великі цифри. */
import { Image } from 'astro:assets';
import Button from '@/components/ui/Button.astro';
import bg from '@/assets/img/home/bg-aurora-2.jpg';
import { paragraphs } from '@/utils/text';

interface Props {
  data: {
    label: string;
    title: string;
    lead: string;
    primaryCta: string;
    secondaryCta: string;
    stats: { value: string; caption: string }[];
  };
  primaryHref: string;
  secondaryHref: string;
  /** Відступ першого рядка (Home — так, Platform — ні) */
  indent?: boolean;
  /** Фонова аврора (Home — так) */
  background?: boolean;
}
const {
  data,
  primaryHref,
  secondaryHref,
  indent = true,
  background = true,
} = Astro.props;
---

<section class="section model" aria-labelledby="model-title">
  {background && (
    <Image
      src={bg}
      alt=""
      class="section-bg model__bg"
      width={2400}
      widths={[800, 1600, 2400]}
      sizes="100vw"
      loading="lazy"
    />
  )}
  <div class="container model__inner">
    <header class="model__head">
      <p class="section-label" data-reveal="fade">
        {data.label}
      </p>
      <h2
        id="model-title"
        class="section-title align-end-lg"
        data-reveal="fade"
      >
        {data.title}
      </h2>
      <div class="model__lead" data-reveal="fade">
        {paragraphs(data.lead).map(p => (
          <p class:list={['lead', indent && 'indent-first']}>{p}</p>
        ))}
      </div>
      <div class="actions model__actions" data-reveal="fade">
        <Button href={primaryHref}>{data.primaryCta}</Button>
        <Button href={secondaryHref} variant="outline">
          {data.secondaryCta}
        </Button>
      </div>
    </header>

    {/* На телефоні — безкінечна стрічка: другий ряд (копія) робить прокрутку без розриву.
        Копія лише для око — скрінрідери її пропускають. */}
    <div class="stats-marquee" data-reveal="fade">
      <div class="stats-track">
        <dl class="stats">
          {data.stats.map(s => (
            <div class="stat" data-reveal="fade">
              <dt class="stat__caption">{s.caption}</dt>
              <dd class="stat__value grad-text num">{s.value}</dd>
            </div>
          ))}
        </dl>
        <div class="stats stats--clone" aria-hidden="true">
          {data.stats.map(s => (
            <div class="stat">
              <p class="stat__caption">{s.caption}</p>
              <p class="stat__value grad-text num">{s.value}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Фон вирівняно по низу: видно нижню частину зображення */
  .model__bg {
    object-position: center bottom;
  }

  .model__inner {
    display: grid;
    gap: var(--section-gap);
  }

  .model__head {
    display: grid;
    gap: var(--space-4);
  }

  .model__lead {
    --indent: 33%;
    display: grid;
    gap: var(--space-8);
    margin-top: var(--space-2);
  }

  .model__actions {
    margin-top: var(--space-4);
  }

  @media (min-width: 1024px) {
    .model__actions {
      justify-content: flex-end;
    }
  }

  .stats {
    display: grid;
    gap: var(--space-8) var(--space-3);
  }

  @media (min-width: 480px) {
    .stats {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 1024px) {
    .stats {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .stat {
    position: relative;
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: var(--space-2);
    padding-left: var(--space-5);
  }

  /* Вертикальна градієнтна лінія ліворуч (крім першої) */
  .stat + .stat::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 1px;
    background: linear-gradient(180deg, #42aa39, #2e509d);
  }

  @media (max-width: 479px) {
    .stat {
      padding-left: 0;
    }
    .stat + .stat::before {
      display: none;
    }
  }

  @media (min-width: 480px) and (max-width: 1023px) {
    .stat:nth-child(3)::before {
      display: none;
    }
    .stat:nth-child(odd) {
      padding-left: 0;
    }
  }

  .stat__value {
    font-size: var(--fs-stat);
    font-weight: var(--fw-semibold);
    line-height: 1;
    white-space: nowrap;
  }

  .stat__caption {
    font-size: var(--fs-meta-m);
    font-weight: var(--fw-medium);
    line-height: 1.4;
    text-transform: uppercase;
    color: var(--color-text-soft);
  }

  /* ---------- Планшет і десктоп: звичайна сітка, без копії ---------- */
  .stats--clone {
    display: none;
  }

  @media (min-width: 640px) {
    /* обгортка тут не анімується — поява лише в кожної цифри окремо */
    .stats-marquee[data-reveal].is-ready {
      opacity: 1;
      transform: none;
      filter: none;
    }
  }

  /* ---------- Телефон: безкінечна горизонтальна стрічка ---------- */
  @media (max-width: 639px) {
    .stats-marquee {
      overflow: hidden;
      margin-inline: calc(-1 * var(--gutter)); /* від краю до краю екрана */
      mask-image: linear-gradient(
        90deg,
        transparent,
        #000 8%,
        #000 92%,
        transparent
      );
    }

    .stats-track {
      display: flex;
      width: max-content;
      animation: stats-scroll 28s linear infinite;
    }

    /* палець на стрічці — зупинка, щоб спокійно прочитати */
    .stats-marquee:hover .stats-track,
    .stats-marquee:active .stats-track {
      animation-play-state: paused;
    }

    .stats,
    .stats--clone {
      display: flex;
      gap: 0;
    }

    .stats .stat {
      flex: 0 0 auto;
      max-width: 15rem;
      padding-inline: var(--space-6);
    }

    /* лінія-розділювач перед кожною цифрою, і в копії теж */
    .stats .stat::before {
      content: '';
      display: block;
      position: absolute;
      left: 0;
      top: 0;
      bottom: 0;
      width: 1px;
      background: linear-gradient(180deg, #42aa39, #2e509d);
    }

    /* поява — у всієї стрічки разом (окремі цифри за краєм екрана інакше лишались би прозорими) */
    .stats-marquee .stat[data-reveal].is-ready {
      opacity: 1;
      transform: none;
      filter: none;
    }
  }

  @keyframes stats-scroll {
    to {
      transform: translateX(-50%);
    }
  }

  /* «Зменшити рух» — без автопрокрутки: стрічку гортають пальцем, копія не потрібна */
  @media (max-width: 639px) and (prefers-reduced-motion: reduce) {
    .stats-marquee {
      overflow-x: auto;
      mask-image: none;
    }
    .stats-track {
      animation: none;
    }
    .stats--clone {
      display: none;
    }
  }
</style>

<script>
  import '@/scripts/reveal';
</script>
