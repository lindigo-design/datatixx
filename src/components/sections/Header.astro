---
/**
 * Navigation (Figma: «Navigation», 74px).
 * Ліворуч логотип, праворуч Login, мова, бургер.
 * Меню відкривається як <dialog> на всіх розмірах екрана — як у макеті.
 */
import Logo from '@/components/ui/Logo.astro';
import LanguageSwitcher from '@/components/ui/LanguageSwitcher.astro';
import Button from '@/components/ui/Button.astro';
import MenuIcon from '@/assets/icons/menu.svg';
import CloseIcon from '@/assets/icons/close.svg';
import { localizePath, useTranslations, type Locale } from '@/i18n/utils';
import { mainNav } from '@/i18n/nav';
import { getSiteSettings } from '@/content/helpers';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const site = await getSiteSettings();
const current = Astro.url.pathname;
---

<header class="nav">
  <div class="container nav__inner">
    <a
      href={localizePath('', lang)}
      class="nav__logo"
      aria-label={t('home.home')}
    >
      <Logo />
    </a>

    <div class="nav__actions">
      {site.loginUrl && (
        <a class="nav__login" href={site.loginUrl} rel="noopener">
          {t('nav.login')}
        </a>
      )}
      <LanguageSwitcher lang={lang} />
      <button
        class="nav__burger"
        type="button"
        aria-haspopup="dialog"
        aria-controls="site-menu"
        data-menu-open
      >
        <MenuIcon aria-hidden="true" />
        <span class="visually-hidden">{t('menu.open')}</span>
      </button>
    </div>
  </div>
</header>

<dialog class="menu" id="site-menu" aria-label={t('nav.main')} data-menu>
  <div class="menu__panel">
    <div class="menu__top">
      <Logo />
      <button class="nav__burger" type="button" data-menu-close>
        <CloseIcon aria-hidden="true" />
        <span class="visually-hidden">{t('menu.close')}</span>
      </button>
    </div>

    <nav aria-label={t('nav.main')}>
      <ul role="list" class="menu__list">
        {mainNav.map((item, i) => {
          const href = localizePath(item.path, lang);
          return (
            <li>
              <a
                class="menu__link"
                href={href}
                aria-current={current === href ? 'page' : undefined}
              >
                <span class="menu__num num" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
                {t(item.key)}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>

    <div class="menu__bottom">
      <Button href={localizePath('contact', lang)}>{t('nav.contact')}</Button>
      {site.loginUrl && (
        <Button href={site.loginUrl} variant="outline">
          {t('nav.login')}
        </Button>
      )}
    </div>
  </div>
</dialog>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--color-bg);
  }

  /* Тонка градієнтна лінія знизу */
  .nav::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 1px;
    background: linear-gradient(90deg, #42aa39 0%, #27509e 50%, #42aa39 100%);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-8);
    min-height: var(--nav-h);
  }

  .nav__logo :global(.logo) {
    width: clamp(132px, 30vw, 168px);
  }

  .nav__actions {
    display: flex;
    align-items: center;
    gap: clamp(var(--space-2), 2vw, var(--space-6));
  }

  .nav__login {
    display: none;
    font-size: var(--fs-meta-m);
    font-weight: var(--fw-medium);
    padding: var(--space-2);
  }

  .nav__login:hover {
    color: var(--color-green);
  }

  @media (min-width: 640px) {
    .nav__login {
      display: inline-block;
    }
  }

  .nav__burger {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-xs);
    color: var(--color-text);
  }

  .nav__burger:hover {
    color: var(--color-green);
  }

  .nav__burger :global(svg) {
    width: 24px;
    height: 24px;
  }

  /* ---------- Меню ---------- */
  .menu {
    width: 100%;
    max-width: 100%;
    height: 100%;
    max-height: 100%;
    margin: 0 0 0 auto;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-text);
  }

  @media (min-width: 768px) {
    .menu {
      width: min(560px, 100%);
    }
  }

  .menu::backdrop {
    background: rgb(1 9 18 / 0.7);
    backdrop-filter: blur(6px);
  }

  .menu__panel {
    display: flex;
    flex-direction: column;
    gap: var(--space-10);
    min-height: 100%;
    padding: var(--space-4) var(--gutter) var(--space-10);
    background: var(--color-bg);
    border-left: 1px solid var(--color-border);
    overflow-y: auto;
  }

  @media (min-width: 768px) {
    .menu__panel {
      padding-inline: var(--space-12);
    }
  }

  .menu[open] .menu__panel {
    animation: menu-in var(--dur-base) var(--ease-out);
  }

  @keyframes menu-in {
    from {
      transform: translateX(24px);
      opacity: 0;
    }
  }

  .menu__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: calc(var(--nav-h) - var(--space-4));
  }

  .menu__list {
    display: grid;
  }

  .menu__link {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
    padding-block: var(--space-3);
    font-size: clamp(1.75rem, 1.5rem + 1vw, 2.25rem);
    font-weight: var(--fw-semibold);
    line-height: 1.2;
    color: var(--color-text-soft);
    border-bottom: 1px solid var(--color-hairline);
  }

  .menu__link:hover,
  .menu__link[aria-current='page'] {
    color: var(--color-text);
  }

  .menu__link:hover .menu__num,
  .menu__link[aria-current='page'] .menu__num {
    color: var(--color-green);
  }

  .menu__num {
    font-size: var(--fs-small);
    font-weight: var(--fw-medium);
    color: var(--color-text-muted);
    letter-spacing: var(--tracking-meta);
  }

  .menu__bottom {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: auto;
  }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-menu]');
  const openBtn = document.querySelector<HTMLButtonElement>('[data-menu-open]');
  const closeBtn =
    document.querySelector<HTMLButtonElement>('[data-menu-close]');

  if (dialog && openBtn && closeBtn) {
    openBtn.addEventListener('click', () => dialog.showModal());
    closeBtn.addEventListener('click', () => dialog.close());
    // Клік по затемненому фону закриває меню
    dialog.addEventListener('click', e => {
      if (e.target === dialog) dialog.close();
    });
    // Клік по пункту меню — закрити (для якорів на тій самій сторінці)
    dialog
      .querySelectorAll('a')
      .forEach(a => a.addEventListener('click', () => dialog.close()));
    // Escape закриває <dialog> сам; фокус повертається на кнопку
    dialog.addEventListener('close', () => openBtn.focus());
  }
</script>
