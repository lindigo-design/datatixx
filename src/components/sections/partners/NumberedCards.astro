---
/** «The human layer of Datixxia™» — заголовок і три картки 01/02/03. */
import { Image } from 'astro:assets';
import aurora from '@/assets/img/home/bg-aurora-3.jpg';

interface Props {
  data: {
    label: string;
    titleStart: string;
    titleAccent: string;
    titleEnd: string;
    lead: string;
    cards: { title: string; text: string }[];
  };
}
const { data } = Astro.props;
---

<section class="section numbered" aria-labelledby="lsp-title">
  <Image
    src={aurora}
    alt=""
    class="section-bg numbered__bg"
    width={2400}
    widths={[800, 1600, 2400]}
    sizes="100vw"
    loading="lazy"
  />
  <div class="container numbered__inner">
    <header class="numbered__head">
      <p class="section-label">{data.label}</p>
      <h2 id="lsp-title" class="section-title align-end-lg">
        {`${data.titleStart} `}
        <span class="grad-text">{data.titleAccent}</span>
        {` ${data.titleEnd}`}
      </h2>
      <p class="section-subtitle indent-first numbered__lead">{data.lead}</p>
    </header>

    <ol role="list" class="numbered__list">
      {data.cards.map((c, i) => (
        <li class:list={['n-card', i === 0 && 'is-active']}>
          <span class="n-card__num grad-text num" aria-hidden="true">
            {String(i + 1).padStart(2, '0')}
          </span>
          <h3 class="n-card__title">{c.title}</h3>
          <p class="n-card__text">{c.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .numbered__inner {
    display: grid;
    gap: var(--section-gap);
  }

  .numbered__head {
    display: grid;
    gap: var(--space-4);
  }

  .numbered__lead {
    --indent: 30%;
    color: var(--color-text-secondary);
  }

  .numbered__list {
    display: grid;
    gap: var(--space-6);
  }

  @media (min-width: 900px) {
    .numbered__list {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* Скляна картка: #babbbd 10%, рамка білим 14%, радіус 24, відступи 32/28, між рядками 12.
     Перша картка — з градієнтною рамкою (як у Figma); інші отримують її при наведенні. */
  .n-card {
    position: relative;
    display: grid;
    align-content: start;
    gap: var(--space-3);
    padding: var(--space-8) 28px;
    background: var(--color-card);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-md);
    min-width: 0;
  }

  .n-card::before {
    content: '';
    position: absolute;
    inset: -1px;
    padding: 1px;
    border-radius: inherit;
    background: var(--gradient-band);
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    mask-composite: exclude;
    opacity: 0;
    transition: opacity var(--dur-base) ease;
    pointer-events: none;
  }

  .n-card.is-active::before,
  .n-card:hover::before {
    opacity: 1;
  }

  /* Цифра: Afacad SemiBold 100 / 80%, градієнт по ширині самої цифри */
  .n-card__num {
    justify-self: start;
    font-size: clamp(3.5rem, 2.4rem + 3.6vw, 6.25rem);
    font-weight: var(--fw-semibold);
    line-height: 0.85;
    padding-block: 0.06em;
  }

  /* Bold 32 / 140% */
  .n-card__title {
    font-size: clamp(1.625rem, 1.45rem + 0.75vw, 2rem);
    font-weight: var(--fw-bold);
    line-height: 1.4;
  }

  .n-card__text {
    color: var(--color-text-secondary);
  }
</style>
