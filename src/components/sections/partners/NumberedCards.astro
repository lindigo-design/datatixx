---
/** «The human layer of Datixxia™» — заголовок і три картки 01/02/03. */
import { Image } from 'astro:assets';
import aurora from '@/assets/img/home/bg-aurora-3.jpg';

interface Props {
  data: {
    label: string;
    titleStart: string;
    titleAccent: string;
    titleEnd: string;
    lead: string;
    cards: { title: string; text: string }[];
  };
}
const { data } = Astro.props;
---

<section class="section numbered" aria-labelledby="lsp-title">
  <Image
    src={aurora}
    alt=""
    class="section-bg numbered__bg"
    widths={[800, 1568]}
    sizes="100vw"
    loading="lazy"
  />
  <div class="container numbered__inner">
    <header class="numbered__head">
      <p class="section-label">{data.label}</p>
      <h2 id="lsp-title" class="section-title align-end-lg">
        {`${data.titleStart} `}
        <span class="grad-text">{data.titleAccent}</span>
        {` ${data.titleEnd}`}
      </h2>
      <p class="section-subtitle indent-first numbered__lead">{data.lead}</p>
    </header>

    <ol role="list" class="numbered__list">
      {data.cards.map((c, i) => (
        <li class="n-card">
          <span class="n-card__num grad-text num" aria-hidden="true">
            {String(i + 1).padStart(2, '0')}
          </span>
          <h3 class="n-card__title">{c.title}</h3>
          <p class="n-card__text">{c.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .numbered__bg {
    opacity: 0.4;
  }

  .numbered__inner {
    display: grid;
    gap: var(--section-gap);
  }

  .numbered__head {
    display: grid;
    gap: var(--space-4);
  }

  .numbered__lead {
    --indent: 30%;
    color: var(--color-text-secondary);
  }

  .numbered__list {
    display: grid;
    gap: var(--space-6);
  }

  @media (min-width: 900px) {
    .numbered__list {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .n-card {
    display: grid;
    align-content: start;
    gap: var(--space-4);
    padding: var(--space-8) 28px;
    background: var(--color-surface);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-md);
  }

  .n-card__num {
    font-size: clamp(3.5rem, 3rem + 2vw, 5rem);
    font-weight: var(--fw-semibold);
    line-height: 0.95;
  }

  .n-card__title {
    font-size: clamp(1.625rem, 1.45rem + 0.75vw, 2rem);
    font-weight: var(--fw-bold);
    line-height: 1.3;
  }

  .n-card__text {
    color: var(--color-text-secondary);
  }
</style>
