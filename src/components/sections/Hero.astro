---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Button from '@/components/ui/Button.astro';

interface Props {
  label?: string;
  title: string;
  lead?: string;
  ctaText?: string;
  ctaHref?: string;
  image?: ImageMetadata | null;
  imageAlt?: string;
}
const {
  label,
  title,
  lead,
  ctaText,
  ctaHref,
  image,
  imageAlt = '',
} = Astro.props;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container hero__inner">
    <div class="hero__content">
      {label && <p class="label hero__label">{label}</p>}
      <h1 id="hero-title" class="hero__title">
        {title}
      </h1>
      {lead && <p class="hero__lead">{lead}</p>}
      {ctaText && ctaHref && <Button href={ctaHref}>{ctaText}</Button>}
    </div>

    {image && (
      <Image
        src={image}
        alt={imageAlt}
        class="hero__image"
        widths={[480, 800, 1200, 1600]}
        sizes="(min-width: 1024px) 45vw, 100vw"
        loading="eager"
        fetchpriority="high"
      />
    )}
  </div>
</section>

<style>
  .hero {
    padding-block: var(--space-16) var(--section-gap);
  }

  .hero__inner {
    display: grid;
    gap: var(--space-12);
    align-items: end;
  }

  @media (min-width: 1024px) {
    .hero__inner:has(.hero__image) {
      grid-template-columns: 1.2fr 1fr;
    }
  }

  .hero__label {
    margin-bottom: var(--space-6);
  }

  .hero__title {
    font-size: var(--fs-display);
    line-height: var(--lh-tight);
    letter-spacing: -0.02em;
    max-width: 14ch;
  }

  .hero__lead {
    max-width: 52ch;
    margin-block: var(--space-6) var(--space-8);
    font-size: var(--fs-body-lg);
    color: var(--color-text-secondary);
  }

  .hero__image {
    width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
  }

  /* Поява при завантаженні — лише CSS, без JS */
  .hero__content > * {
    animation: rise 700ms var(--ease-out) both;
  }
  .hero__content > :nth-child(2) {
    animation-delay: 70ms;
  }
  .hero__content > :nth-child(3) {
    animation-delay: 140ms;
  }
  .hero__content > :nth-child(4) {
    animation-delay: 210ms;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
