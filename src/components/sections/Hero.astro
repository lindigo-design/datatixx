---
/** Header / 111 / — головний екран з глобусом. */
import { Image } from 'astro:assets';
import Button from '@/components/ui/Button.astro';
import heroImage from '@/assets/img/home/hero-globe.jpeg';

interface Props {
  title: string;
  lead: string;
  primaryCta: string;
  primaryHref: string;
  secondaryCta: string;
  secondaryHref: string;
  imageAlt?: string;
}
const {
  title,
  lead,
  primaryCta,
  primaryHref,
  secondaryCta,
  secondaryHref,
  imageAlt = '',
} = Astro.props;
---

<section class="hero" aria-labelledby="hero-title">
  <Image
    src={heroImage}
    alt={imageAlt}
    class="hero__bg"
    widths={[640, 960, 1280, 1920, 2752]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
  />
  <div class="container hero__inner">
    <h1 id="hero-title" class="hero__title">
      {title}
    </h1>
    <div class="hero__content">
      <p class="hero__lead lead">{lead}</p>
      <div class="actions">
        <Button href={primaryHref}>{primaryCta}</Button>
        <Button href={secondaryHref} variant="outline">
          {secondaryCta}
        </Button>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: center;
    min-height: clamp(560px, 58vw, 835px);
    padding-block: var(--space-16) var(--section-pad);
    overflow: hidden;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }

  /* Затемнення донизу, як у макеті (Rectangle 1) */
  .hero::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 88%;
    z-index: -1;
    background: var(--gradient-hero-fade);
  }

  .hero__inner {
    display: grid;
    gap: var(--space-6);
  }

  .hero__title {
    font-size: var(--fs-display);
    font-weight: var(--fw-semibold);
    line-height: var(--lh-display);
    letter-spacing: var(--tracking-display);
    max-width: 13ch;
    text-shadow: 0 2px 24px rgb(1 9 18 / 0.5);
  }

  .hero__content {
    display: grid;
    gap: var(--space-8);
    max-width: 714px;
  }

  @media (min-width: 1024px) {
    .hero__title {
      max-width: none;
    }

    /* Підзаголовок і кнопки зсунуті праворуч, як у макеті */
    .hero__content {
      margin-left: auto;
      width: 58%;
    }
  }

  .hero__lead {
    text-shadow: 0 1px 12px rgb(1 9 18 / 0.6);
  }

  .hero__inner > * {
    animation: rise 800ms var(--ease-out) both;
  }

  .hero__inner > :nth-child(2) {
    animation-delay: 120ms;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
  }
</style>
