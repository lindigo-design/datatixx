---
/**
 * Форма зв'язку (Contact і Partners) — поля як у Figma.
 * Працює і без JavaScript, а з JS — без перезавантаження сторінки (scripts/forms.ts).
 * Обробник: public/api/contact.php.
 */
import Button from '@/components/ui/Button.astro';
import FormDone from '@/components/ui/FormDone.astro';
import { useTranslations, withBase, type Locale } from '@/i18n/utils';

interface Props {
  lang: Locale;
  /** Сторінка, на яку повертати після відправки без JS */
  page: 'contact' | 'partners';
  /** Показати вибір теми («What is it about?») */
  topics?: boolean;
}
const { lang, page, topics = false } = Astro.props;
const t = useTranslations(lang);
const topicList = [
  'demo',
  'partnership',
  'provider',
  'press',
  'support',
] as const;
---

<form
  class="form"
  action={withBase('/api/contact.php')}
  method="post"
  novalidate
  data-ajax-form
  data-msg-sending={t('form.sending')}
  data-msg-success={t('form.success')}
  data-msg-error={t('form.error')}
  data-msg-required={t('form.required')}
  data-msg-hint={t('form.hint')}
>
  <input type="hidden" name="lang" value={lang} />
  <input type="hidden" name="page" value={page} />
  <input type="hidden" name="ts" value="" data-ts />
  <div class="form__trap" aria-hidden="true">
    <label>
      Website{' '}
      <input type="text" name="website" tabindex="-1" autocomplete="off" />
    </label>
  </div>

  {topics && (
    <fieldset class="chips field">
      <legend>{t('form.topic')}</legend>
      {topicList.map((key, i) => (
        <label class="chip">
          <input type="radio" name="topic" value={key} checked={i === 0} />
          <span>{t(`topic.${key}`)}</span>
        </label>
      ))}
    </fieldset>
  )}

  <div class:list={['form__fields', topics && 'form-card']}>
    <div class="form__row">
      <div class="field">
        <label for={`${page}-first`}>{t('form.firstName')} *</label>
        <input
          id={`${page}-first`}
          name="firstName"
          type="text"
          autocomplete="given-name"
          placeholder={t('form.firstNamePh')}
          required
          maxlength="80"
        />
      </div>
      <div class="field">
        <label for={`${page}-last`}>{t('form.lastName')} *</label>
        <input
          id={`${page}-last`}
          name="lastName"
          type="text"
          autocomplete="family-name"
          placeholder={t('form.lastNamePh')}
          required
          maxlength="80"
        />
      </div>
    </div>

    <div class="form__row">
      <div class="field">
        <label for={`${page}-email`}>{t('form.email')} *</label>
        <input
          id={`${page}-email`}
          name="email"
          type="email"
          autocomplete="email"
          placeholder={t('form.emailPh')}
          required
          maxlength="160"
        />
      </div>
      <div class="field">
        <label for={`${page}-subject`}>{t('form.subject')} *</label>
        <input
          id={`${page}-subject`}
          name="subject"
          type="text"
          placeholder={t('form.subjectPh')}
          required
          maxlength="160"
        />
      </div>
    </div>

    <div class="field">
      <label for={`${page}-message`}>{t('form.message')} *</label>
      <textarea
        id={`${page}-message`}
        name="message"
        rows="5"
        placeholder={t('form.messagePh')}
        required
        minlength="10"
        maxlength="4000"
      ></textarea>
    </div>

    <div class="form__footer">
      <Button type="submit">{t('form.submit')}</Button>
      <p class="form__status" role="status" aria-live="polite" data-status></p>
      <p class="form__hint" id={`${page}-hint`} data-hint hidden></p>
      <p class="form__note">{t('form.privacyNote')}</p>
    </div>
  </div>
  <FormDone lang={lang} />
</form>

<style>
  .form__fields {
    display: grid;
    gap: var(--space-5);
  }

  /* Contact (Figma «form-card»): padding 36, вище поле повідомлення, кнопка 52px */
  .form__fields.form-card {
    padding: clamp(var(--space-6), 3vw, 36px);
  }

  /* Figma: поле повідомлення 157px */
  .form-card textarea {
    min-height: 157px;
  }

  .form-card .form__footer :global(.btn) {
    min-height: 52px;
    padding: 14px var(--space-8);
  }
</style>

<script>
  import '@/scripts/forms';
</script>
