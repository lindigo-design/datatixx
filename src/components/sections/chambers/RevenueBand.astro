---
/** «Your postcode. Your revenue.» — градієнтна стрічка з двома цифрами. */
interface Props {
  data: {
    label: string;
    title: string;
    text: string;
    stats: { value: string; caption: string }[];
  };
}
const { data } = Astro.props;
---

<section class="revenue" aria-labelledby="revenue-title">
  <div class="container">
    <div class="revenue__band">
      <div class="revenue__copy">
        <p class="meta-s revenue__tag">{data.label}</p>
        <h2 id="revenue-title" class="revenue__title">
          {data.title}
        </h2>
        <p>{data.text}</p>
      </div>
      <dl class="revenue__stats">
        {data.stats.map(s => (
          <div class="r-stat">
            <dt class="meta-s">{s.caption}</dt>
            <dd class="r-stat__value num">{s.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>

<style>
  .revenue {
    padding-bottom: var(--section-pad);
  }

  .revenue__band {
    display: grid;
    gap: var(--space-10);
    align-items: center;
    padding: clamp(var(--space-8), 4vw, var(--space-14, 3.5rem));
    border-radius: var(--radius-lg);
    background: var(--gradient-band);
  }

  @media (min-width: 1024px) {
    .revenue__band {
      grid-template-columns: 1fr 400px;
      gap: var(--space-12);
    }
  }

  .revenue__copy {
    display: grid;
    gap: var(--space-4);
  }

  .revenue__tag {
    color: var(--color-text);
  }

  .revenue__title {
    font-size: clamp(2.5rem, 1.8rem + 3vw, 4.25rem); /* 40 → 68 */
    font-weight: var(--fw-bold);
    line-height: 1;
  }

  .revenue__stats {
    display: grid;
    gap: var(--space-3);
  }

  .r-stat {
    display: flex;
    flex-direction: column-reverse;
    gap: var(--space-2);
    padding: var(--space-6);
    background: var(--color-bg);
    border-radius: var(--radius-sm);
  }

  .r-stat dt {
    color: var(--color-text-secondary);
  }

  .r-stat__value {
    font-size: clamp(3rem, 2.6rem + 1.6vw, 4rem);
    font-weight: var(--fw-semibold);
    line-height: 1;
  }
</style>
