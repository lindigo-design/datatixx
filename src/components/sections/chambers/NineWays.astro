---
/** «Nine ways Datixxia™ works for chambers»: три великі картки (bento) + список із шести пунктів. */
import { Image } from 'astro:assets';
import aurora from '@/assets/img/home/bg-aurora-1.jpg';

interface Props {
  data: {
    label: string;
    titleStart: string;
    titleAccent: string;
    titleEnd: string;
    lead: string;
    pillars: {
      tag: string;
      title: string;
      text: string;
      vizCaption: string;
      vizTag: string;
    }[];
    moreTitle: string;
    more: { title: string; text: string }[];
  };
}
const { data } = Astro.props;
const [main, members, revenue] = data.pillars;
const num = (i: number) => String(i).padStart(2, '0');
---

<section class="section nine" aria-labelledby="nine-title">
  <Image
    src={aurora}
    alt=""
    class="section-bg nine__bg"
    width={2400}
    widths={[800, 1600, 2400]}
    sizes="100vw"
    loading="lazy"
  />
  <div class="container nine__inner">
    <header class="nine__head">
      <p class="section-label">{data.label}</p>
      <h2 id="nine-title" class="section-title">
        {`${data.titleStart} `}
        <span class="grad-text">{data.titleAccent}</span>
        {` ${data.titleEnd}`}
      </h2>
      <p class="section-subtitle nine__lead">{data.lead}</p>
    </header>

    <div class="bento">
      {main && (
        <article class="bento__card bento__card--main">
          <p class="meta-s mono accent">{`01 — ${main.tag}`}</p>
          <h3 class="bento__title bento__title--lg">{main.title}</h3>
          <p class="bento__text">{main.text}</p>
          <div class="bento__viz" aria-hidden="true">
            {Array.from({ length: 7 }, (_, j) => (
              <span class:list={['bento__bar', j >= 5 && 'is-forecast']} />
            ))}
          </div>
          <p class="bento__caption meta-s mono">
            <span>{main.vizCaption}</span>
            <span class="accent">{main.vizTag}</span>
          </p>
        </article>
      )}
      <div class="bento__stack">
        {members && (
          <article class="bento__card">
            <p class="meta-s mono accent">{`02 — ${members.tag}`}</p>
            <h3 class="bento__title">{members.title}</h3>
            <p class="bento__text">{members.text}</p>
          </article>
        )}
        {revenue && (
          <article class="bento__card bento__card--grad">
            <p class="meta-s mono bento__tag-light">{`03 — ${revenue.tag}`}</p>
            <h3 class="bento__title">{revenue.title}</h3>
            <p class="bento__text bento__text--light">{revenue.text}</p>
          </article>
        )}
      </div>
    </div>

    <div class="more">
      <h3 class="more__title">{data.moreTitle}</h3>
      <ol role="list" class="more__list">
        {data.more.map((m, i) => (
          <li class="more__item">
            <span class="more__num num accent" aria-hidden="true">
              {num(i + 4)}
            </span>
            <div>
              <h4 class="more__name">{m.title}</h4>
              <p class="more__text">{m.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .accent {
    color: var(--color-green);
  }

  /* Figma: між блоками секції 64 */
  .nine__inner {
    display: grid;
    gap: var(--space-16);
  }

  .nine__head {
    display: grid;
    gap: var(--space-4);
    justify-items: center;
    text-align: center;
  }

  .nine__head .section-label {
    justify-self: start;
  }

  .nine__lead {
    color: var(--color-text-secondary);
  }

  /* ---------- Bento ---------- */
  .bento {
    display: grid;
    gap: var(--space-6);
  }

  @media (min-width: 1024px) {
    .bento {
      grid-template-columns: 736fr 480fr;
    }
  }

  .bento__stack {
    display: grid;
    gap: var(--space-6);
  }

  /* Figma: скляна картка #babbbd 10%, рамка білим 14%, радіус 24, відступи 28, між рядками 12 */
  .bento__card {
    display: grid;
    align-content: start;
    gap: var(--space-3);
    padding: 28px;
    background: var(--color-card);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-md);
    min-width: 0;
  }

  /* Велика картка: відступи 40/36, між рядками 16 */
  .bento__card--main {
    gap: var(--space-4);
    padding: var(--space-10) 36px;
  }

  .bento__card--grad {
    background: var(--gradient-band);
    border-color: transparent;
  }

  .bento__tag-light {
    color: var(--color-text);
  }

  /* Заголовки карток: Afacad Bold 32 / 140% */
  .bento__title {
    font-size: clamp(1.5rem, 1.3rem + 0.8vw, 2rem);
    font-weight: var(--fw-bold);
    line-height: 1.4;
  }

  /* Велика картка: Bold 48 / 100% */
  .bento__title--lg {
    font-size: clamp(1.875rem, 1.4rem + 1.9vw, 3rem);
    line-height: 1.05;
  }

  .bento__text {
    color: var(--color-text-secondary);
  }

  .bento__text--light {
    color: var(--color-text);
  }

  /* Міні-графік: стовпчики 56 завширшки, 12 між ними, найвищий 118, радіус 4 */
  .bento__viz {
    display: flex;
    align-items: flex-end;
    gap: var(--space-3);
    height: 118px;
    margin-top: var(--space-4);
  }

  .bento__bar {
    flex: 0 1 56px;
    background: #3d444d;
    border-radius: 4px;
  }

  .bento__bar.is-forecast {
    background: linear-gradient(90deg, #42aa39, #27509e);
  }

  /* висоти стовпчиків з Figma (44 68 56 88 72 118 96 з 118) — без inline-стилів (CSP) */
  .bento__bar:nth-child(1) {
    height: 37%;
  }
  .bento__bar:nth-child(2) {
    height: 58%;
  }
  .bento__bar:nth-child(3) {
    height: 47%;
  }
  .bento__bar:nth-child(4) {
    height: 75%;
  }
  .bento__bar:nth-child(5) {
    height: 61%;
  }
  .bento__bar:nth-child(6) {
    height: 100%;
  }
  .bento__bar:nth-child(7) {
    height: 81%;
  }

  .bento__caption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
    margin-top: calc(var(--space-2) * -1); /* 8 від графіка, як у макеті */
  }

  /* ---------- Ще шість ---------- */
  .more {
    display: grid;
    gap: var(--space-16);
  }

  .more__title {
    font-size: clamp(1.5rem, 1.3rem + 0.8vw, 2rem);
    font-weight: var(--fw-bold);
    line-height: 1.4;
  }

  .more__list {
    display: grid;
    column-gap: var(--space-12);
    border-top: 1px solid var(--color-hairline);
  }

  @media (min-width: 900px) {
    .more__list {
      grid-template-columns: 1fr 1fr;
      grid-auto-flow: column;
      grid-template-rows: repeat(3, auto);
      border-top: 0;
    }
    .more__item {
      border-top: 1px solid var(--color-hairline);
    }
  }

  /* Рядок: номер 36 + 20 + текст; відступи 20/4 */
  .more__item {
    display: grid;
    grid-template-columns: 36px 1fr;
    gap: var(--space-5);
    padding: var(--space-5) 4px;
    border-bottom: 1px solid var(--color-hairline);
  }

  /* Номер: IBM Plex Mono Medium 14 */
  .more__num {
    font-family: var(--font-mono);
    font-size: var(--fs-label-14);
    font-weight: 500;
    line-height: 20px;
    padding-top: var(--space-3);
  }

  .more__name {
    font-size: clamp(1.375rem, 1.2rem + 0.75vw, 2rem);
    font-weight: var(--fw-bold);
    line-height: 1.4;
    margin-bottom: 4px;
  }

  .more__text {
    font-size: var(--fs-small);
    line-height: 1.5;
    color: var(--color-text-muted);
  }
</style>
