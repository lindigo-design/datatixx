---
/**
 * «A sustainable revenue engine» (Figma «Outcomes — Measurable»): три картки-цифри, примітка і текст.
 * Фон — рівний темний, без зображення (як у макеті).
 */
interface Props {
  data: {
    label: string;
    titleStart: string;
    titleAccent: string;
    stats: { value: string; caption: string }[];
    note: string;
    text: string;
  };
}
const { data } = Astro.props;
---

<section class="section outcomes" aria-labelledby="outcomes-title">
  <div class="container outcomes__inner">
    <header class="outcomes__head">
      <p class="section-label">{data.label}</p>
      <h2 id="outcomes-title" class="section-title align-end-lg">
        {`${data.titleStart} `}
        <span class="grad-text">{data.titleAccent}</span>
      </h2>
    </header>

    <dl class="outcomes__stats">
      {data.stats.map(s => (
        <div class="o-card">
          <dt class="meta-s mono">{s.caption}</dt>
          <dd class="o-card__value grad-text num">{s.value}</dd>
        </div>
      ))}
    </dl>

    <p class="meta-s mono outcomes__note">{data.note}</p>
    <p class="outcomes__text">{data.text}</p>
  </div>
</section>

<style>
  /* Figma: між блоками 48 */
  .outcomes__inner {
    display: grid;
    gap: var(--space-12);
  }

  .outcomes__head {
    display: grid;
    gap: var(--space-4);
  }

  .outcomes__stats {
    display: grid;
    gap: var(--space-6);
  }

  @media (min-width: 1024px) {
    .outcomes__stats {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  /* Скляна картка: #babbbd 10%, рамка білим 14%, радіус 24, відступи 32/28, між рядками 12 */
  .o-card {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: var(--space-3);
    padding: var(--space-8) 28px;
    background: var(--color-card);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-md);
    min-width: 0;
  }

  .o-card dt {
    color: var(--color-text-secondary);
  }

  /* Цифра: Afacad SemiBold 100 / 80%. Градієнт зелений → синій по ширині самої цифри */
  .o-card__value {
    align-self: flex-start;
    font-size: clamp(3.5rem, 2.4rem + 3.6vw, 6.25rem); /* 56 → 100 */
    font-weight: var(--fw-semibold);
    line-height: 0.85;
    padding-block: 0.06em; /* щоб градієнт не обрізав верх і низ літер */
    white-space: nowrap;
  }

  .outcomes__note {
    text-align: center;
  }

  .outcomes__text {
    max-width: 880px;
    margin-inline: auto;
    text-align: center;
    font-size: var(--fs-body-lg);
    color: var(--color-text-secondary);
  }
</style>
