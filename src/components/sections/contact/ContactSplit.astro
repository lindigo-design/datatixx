---
/**
 * «Contact — Split» (Figma 10294:10092, оновлено 08.10).
 * Ліворуч: теми + форма. Праворуч: ОДНА картка — офіс, e-mail, телефон, LinkedIn.
 * На десктопі картка починається на одному рівні з карткою форми і має ту саму висоту
 * (CSS subgrid: форма займає два ряди сітки — «теми» і «картка форми»).
 * Figma v2: під формою — блок «Becoming a DataTixx territorial representative?»,
 * у картці праворуч зверху — зображення; картка тягнеться до низу цього блоку.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import ContactForm from '@/components/sections/ContactForm.astro';
import IconLinkedin from '@/assets/icons/social-linkedin.svg';
import { useTranslations, type Locale } from '@/i18n/utils';
import { getSiteSettings, telHref } from '@/content/helpers';

interface Props {
  lang: Locale;
  /** Координати офісу — зараз не показуються (карти в новому макеті немає), лишаються в даних */
  map?: { lat: number; lon: number };
  territorial: { title: string; text: string };
}
const { lang, territorial } = Astro.props;

// Зображення в картці офісу: src/assets/img/contact/contact-hq.(jpg|jpeg|png|webp).
// Поки файлу немає — картка просто без зображення, збірка не ламається.
const found = Object.values(
  import.meta.glob<{ default: ImageMetadata }>(
    '/src/assets/img/contact/contact-hq.{jpg,jpeg,png,webp}',
    { eager: true }
  )
)[0];
const hqImage = found?.default;
const t = useTranslations(lang);
const site = await getSiteSettings();
const a = site.address;
const linkedin = site.social.linkedin;
---

<section class="c-split" id="form" aria-label={t('nav.contact')}>
  <div class="container c-split__inner">
    <ContactForm lang={lang} page="contact" topics />

    <aside class="c-note">
      <p class="c-label">{territorial.title}</p>
      <p class="c-note__text">{territorial.text}</p>
    </aside>

    <aside class="c-card">
      {hqImage && (
        <Image
          src={hqImage}
          alt=""
          class="c-card__img"
          widths={[400, 742, 1113]}
          sizes="(min-width: 1024px) 371px, 100vw"
          loading="lazy"
        />
      )}
      <div class="c-group c-group--hq">
        <p class="c-label">{t('contact.hq')}</p>
        <p class="c-value">{site.companyName}</p>
        <address class="c-address">
          <span class="c-street">{`${a.street}, ${a.box}`}</span>
          <br />
          {`${a.postalCode} ${a.city}, ${a.country}`}
        </address>
      </div>

      <div class="c-group">
        <p class="c-label">{t('contact.email')}</p>
        <a class="c-value c-link" href={`mailto:${site.email}`}>
          {site.email}
        </a>
      </div>

      {site.phone && (
        <div class="c-group">
          <p class="c-label">{t('contact.phone')}</p>
          <a class="c-value c-link num" href={telHref(site.phone)}>
            {site.phone}
          </a>
        </div>
      )}

      {linkedin && (
        <div class="c-group">
          <p class="c-label">{t('contact.linkedin')}</p>
          <a
            class="c-icon"
            href={linkedin}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedIn DataTixx"
          >
            <IconLinkedin aria-hidden="true" />
          </a>
        </div>
      )}
    </aside>
  </div>
</section>

<style>
  /* Figma: 80 зверху, 112 знизу, 48 між колонками */
  .c-split {
    padding-block: clamp(var(--space-12), 5.5vw, var(--space-20))
      var(--section-pad);
  }

  .c-split__inner {
    display: grid;
    gap: var(--space-12);
  }

  @media (min-width: 1024px) {
    .c-split__inner {
      grid-template-columns: 772fr 420fr;
      grid-template-rows: auto auto auto;
      column-gap: var(--space-12);
      row-gap: var(--space-5);
    }

    /* Форма займає два ряди: 1 — теми, 2 — картка форми */
    .c-split__inner > :global(.form) {
      grid-row: 1 / span 2;
      grid-template-rows: subgrid;
    }

    /* Після відправки панель «надіслано» стає на місце картки форми */
    .c-split__inner :global(.form__done) {
      grid-row: 2;
    }

    /* Картка контактів — у другому ряду, на всю висоту картки форми */
    .c-card {
      grid-column: 2;
      grid-row: 2 / span 2;
    }
  }

  /* Блок під формою (Figma «note — territorial rep»): рамка зелена, радіус 16, відступи 20/24 */
  .c-note {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-5) var(--space-6);
    background: var(--color-surface);
    border: 1px solid var(--color-green);
    border-radius: var(--radius-sm);
  }

  .c-note__text {
    color: var(--color-text-secondary);
  }

  @media (min-width: 1024px) {
    .c-note {
      grid-column: 1;
      grid-row: 3;
    }
  }

  /* Зображення зверху картки: 371×169, радіус 12 */
  .c-card__img {
    width: 100%;
    aspect-ratio: 371 / 169;
    object-fit: cover;
    border-radius: 12px;
  }

  /* Figma «card — HQ»: фон #babbbd 10%, рамка білим 14%, радіус 20, відступи 36/24, між блоками 24 */
  .c-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    padding: clamp(var(--space-6), 2.5vw, 36px) var(--space-6);
    background: var(--color-card);
    border: 1px solid var(--color-hairline);
    border-radius: 20px;
    min-width: 0;
  }

  .c-group {
    display: grid;
    justify-items: start;
    gap: 6px;
  }

  .c-group--hq {
    gap: var(--space-3);
  }

  /* Мітки: IBM Plex Mono 11, +6%, зелені */
  .c-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    line-height: 16px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-green);
  }

  /* Назва, e-mail, телефон: Afacad Bold 32 / 140% */
  .c-value {
    font-size: clamp(1.5rem, 1.3rem + 0.8vw, 2rem);
    font-weight: var(--fw-bold);
    line-height: 1.4;
    overflow-wrap: anywhere;
  }

  .c-link:hover {
    color: var(--color-green);
  }

  .c-address {
    font-style: normal;
    color: var(--color-text-secondary);
  }

  .c-street {
    text-transform: uppercase;
  }

  /* LinkedIn: блок 42×42, іконка 32, колір #dfdfdf */
  .c-icon {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    color: #dfdfdf;
    transition: color var(--dur-fast) ease;
  }

  .c-icon :global(svg) {
    width: 32px;
    height: 32px;
  }

  .c-icon:hover {
    color: var(--color-green);
  }
</style>
