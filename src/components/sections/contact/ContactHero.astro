---
/** «Let’s talk» — невеликий центрований hero з авророю. */
import { Image } from 'astro:assets';
import aurora from '@/assets/img/home/bg-aurora-3.jpg';

interface Props {
  data: { label: string; title: string; lead: string };
}
const { data } = Astro.props;
---

<section class="c-hero" aria-labelledby="c-hero-title">
  <Image
    src={aurora}
    alt=""
    class="section-bg c-hero__bg"
    width={2400}
    widths={[800, 1600, 2400]}
    sizes="100vw"
    loading="eager"
  />
  <div class="container c-hero__inner">
    <p class="section-label">{data.label}</p>
    <h1 id="c-hero-title" class="c-hero__title">
      {data.title}
    </h1>
    <p class="section-subtitle c-hero__lead">{data.lead}</p>
  </div>
</section>

<style>
  .c-hero {
    position: relative;
    isolation: isolate;
    /* Figma v2: 120 зверху, 80 знизу */
    padding-block: clamp(var(--space-16), 8.3vw, 120px)
      clamp(var(--space-12), 5.5vw, var(--space-20));
    overflow: hidden;
  }

  .c-hero__inner {
    display: grid;
    gap: var(--space-5);
    justify-items: center;
    text-align: center;
  }

  .c-hero__title {
    font-size: clamp(3rem, 1.9rem + 4.9vw, 6.25rem); /* 48 → 100 */
    font-weight: var(--fw-semibold);
    line-height: 0.9;
  }

  .c-hero__lead {
    max-width: 820px;
    color: var(--color-text-secondary);
  }
</style>
