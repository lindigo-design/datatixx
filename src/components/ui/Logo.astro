---
/** Логотип Datixxia™ (горизонтальний, з Figma: «logo tixx fin horz 1»). */
interface Props {
  class?: string;
  width?: number;
  height?: number;
}
const { class: className, width = 168, height = 40 } = Astro.props;
---

<img
  class:list={['logo', className]}
  src="/img/logo-datixxia.svg"
  alt="Datixxia™ — See Tomorrow. Act Today."
  width={width}
  height={height}
  decoding="async"
/>

<style>
  .logo {
    display: block;
    height: auto;
  }
</style>
