---
/**
 * Спільний каркас кожної сторінки: <head>, SEO, мови, шапка, футер.
 * Аналог index.html з <load src="partials/..."> у шаблоні GoIT.
 */
import '@/styles/global.css';
import Header from '@/components/sections/Header.astro';
import Footer from '@/components/sections/Footer.astro';
import TickerBar from '@/components/sections/TickerBar.astro';
import IntroLoader from '@/components/ui/IntroLoader.astro';
import {
  locales,
  switchLocale,
  useTranslations,
  withBase,
  type Locale,
} from '@/i18n/utils';
import { getSiteSettings } from '@/content/helpers';
import { introScript, introScriptHash } from '@/scripts/intro';

Astro.csp?.insertScriptHash(introScriptHash);

interface Props {
  lang: Locale;
  title: string;
  description: string;
  ogImage?: string;
  /** Сховати сторінку від Google (для чернеток) */
  noindex?: boolean;
}

const {
  lang,
  title,
  description,
  ogImage = '/og-image.png',
  noindex: noindexProp = false,
} = Astro.props;
// Попередній перегляд на GitHub Pages ховаємо від Google, щоб він не конкурував з datatixx.com
const noindex = noindexProp || import.meta.env.PUBLIC_PREVIEW === '1';
const t = useTranslations(lang);
const site = await getSiteSettings();
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(withBase(ogImage), Astro.site);

const organizationLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.companyName,
  brand: site.brandName,
  url: Astro.site?.href,
  email: site.email,
  telephone: site.phone || undefined,
  sameAs: Object.values(site.social).filter(Boolean),
  address: {
    '@type': 'PostalAddress',
    streetAddress: `${site.address.street}, ${site.address.box}`,
    postalCode: site.address.postalCode,
    addressLocality: site.address.city,
    addressCountry: 'FR',
  },
};
---

<!doctype html>
<html lang={lang} dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline set:html={introScript} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    {/* Та сама сторінка іншими мовами — для Google */}
    {locales.map(l => (
      <link
        rel="alternate"
        hreflang={l}
        href={new URL(switchLocale(Astro.url.pathname, l), Astro.site)}
      />
    ))}
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(switchLocale(Astro.url.pathname, 'en'), Astro.site)}
    />

    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <meta name="theme-color" content="#010912" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />

    {/* Як сторінка виглядає при поширенні в LinkedIn */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.brandName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content={lang === 'fr' ? 'fr_FR' : 'en_GB'} />
    <meta name="twitter:card" content="summary_large_image" />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(organizationLd)}
      is:inline
    />
  </head>
  <body>
    <a class="skip-link" href="#main">
      {t('skipToContent')}
    </a>
    <IntroLoader />
    <Header lang={lang} />
    <TickerBar lang={lang} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
