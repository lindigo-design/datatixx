# =========================================================================
#  DataTixx — налаштування сервера Apache (IONOS)
#  Цей файл копіюється в корінь сайту під час збірки.
# =========================================================================

Options -Indexes
ServerSignature Off
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. Завжди HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2. З www → без www. Основна адреса — https://datatixx.com, як у старого сайту,
  #    тож Google і LinkedIn не «губляться» після переїзду.
  RewriteCond %{HTTP_HOST} ^www\.datatixx\.com$ [NC]
  RewriteRule ^ https://datatixx.com%{REQUEST_URI} [L,R=301]

  # 3. Старі сторінки WordPress → нові (301 = «переїхала назавжди», Google переносить позиції).
  #    Список зібрано з datatixx.com/sitemap_index.xml 09.10.2026 — див. docs/old-site-urls.md
  RewriteRule ^about/?$                                  /en/about/      [R=301,L]
  RewriteRule ^datixia/?$                                /en/platform/   [R=301,L]
  RewriteRule ^benefits/?$                               /en/benefits/   [R=301,L]
  RewriteRule ^partners/?$                               /en/partners/   [R=301,L]
  RewriteRule ^benefit-for-chambers-of-commerce/?$       /en/chambers/   [R=301,L]
  RewriteRule ^benefit-for-translation-companies/?$      /en/partners/   [R=301,L]
  RewriteRule ^team/?$                                   /en/team/       [R=301,L]
  RewriteRule ^contact-datixxia/?$                       /en/contact/    [R=301,L]
  RewriteRule ^investors/?$                              /en/contact/    [R=301,L]
  RewriteRule ^legal-notice-tixx-terms-privacy-compliance/?$ /en/legal/  [R=301,L]
  RewriteRule ^privacy-policy/?$                         /en/privacy/    [R=301,L]
  # старі карти сайту → нова
  RewriteRule ^(sitemap_index|page-sitemap|sitemap)\.xml$ /sitemap-index.xml [R=301,L]
  # старі короткі посилання WordPress (?p=123) → головна
  RewriteCond %{QUERY_STRING} (^|&)(p|page_id)=\d+
  RewriteRule ^$ /en/? [R=301,L]

  # 4. Службові адреси WordPress — «видалено назавжди» (410), щоб боти перестали їх перевіряти
  RewriteRule ^wp-admin(/.*)?$ - [G,L]
  RewriteRule ^wp-login\.php$ - [G,L]
  RewriteRule ^xmlrpc\.php$ - [G,L]
  RewriteRule ^wp-(content|includes|json)(/.*)?$ - [G,L]
  RewriteRule ^(elementor-hf|metform-form)(/.*)?$ - [G,L]
  RewriteRule ^(comments/)?feed/?$ - [G,L]

  # 5. Корінь «/» → мова браузера (фр. → /fr/, інші → /en/)
  RewriteCond %{HTTP:Accept-Language} ^fr [NC]
  RewriteRule ^$ /fr/ [L,R=302]
  RewriteRule ^$ /en/ [L,R=302]
</IfModule>

# Заборонити доступ до службових файлів
<FilesMatch "^(_.*|config(\.example)?\.php|\.env.*|\.template-renderer-data|.*\.(md|log|ini|lock|json))$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  # Безпека
  # без includeSubDomains: піддомени (newsletter.datatixx.com тощо) живуть окремо, не нав'язуємо їм HTTPS
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set X-Frame-Options "DENY"
  # Основна CSP — у <meta> кожної сторінки (Astro). Тут — те, що meta не вміє:
  Header always set Content-Security-Policy "frame-ancestors 'none'"
  Header always unset X-Powered-By
  Header unset X-Powered-By

  # Кешування: файли з хешем у назві (/_astro/) — назавжди, решта — коротко, HTML — завжди свіжий
  <If "%{REQUEST_URI} =~ m#^/_astro/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <ElseIf "%{REQUEST_URI} =~ m#^/api/#">
    # Відповіді форм не кешувати ніде (інакше перекрили б no-store з PHP)
    Header set Cache-Control "no-store"
  </ElseIf>
  <Else>
    Header set Cache-Control "public, max-age=3600"
  </Else>
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# Стиснення
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>

ErrorDocument 404 /404.html
